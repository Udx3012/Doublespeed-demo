# =====================================================================
# DOUBLESPEED PIPELINE ENVIRONMENT CONFIGURATION (EXAMPLE)
# =====================================================================

# 1. LLM ENGINE (Google Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.5-flash

# 2. WEB SCRAPING (Firecrawl API)
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# 3. AI AVATAR VIDEO CREATION (HeyGen / Synthesia)
HEYGEN_API_KEY=your_heygen_api_key_here
HEYGEN_AVATAR_ID=your_heygen_avatar_id
HEYGEN_VOICE_ID=your_heygen_voice_id

# 4. SPEECH-TO-TEXT & CAPTIONS (ElevenLabs / Local Whisper)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# 5. SOCIAL MEDIA AUTO-POSTING
SIMULATE_POSTING=true
BROWSER_USE_API_KEY=your_browser_use_api_key_here
